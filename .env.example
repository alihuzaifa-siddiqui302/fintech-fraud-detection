# ==============================================================================
# FraudGuard — Environment Variables Template
# Copy this file: cp .env.example .env
# Fill in all values before running locally or deploying
# NEVER commit .env to version control (already in .gitignore)
# ==============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Local Docker: use any password you like
# Production (Neon): copy the full connection string from neon.tech dashboard
DB_PASSWORD=your_secure_postgres_password
# Production only — full Neon connection string:
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=postgres

# ── JWT Secret ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-random-256-bit-secret-minimum-32-chars!!

# ── Redis ──────────────────────────────────────────────────────────────────────
# Local Docker: leave blank (no auth)
# Production (Upstash): copy from console.upstash.com → Redis → Details
# REDIS_URL=rediss://default:<token>@<host>.upstash.io:<port>

# ── Kafka ──────────────────────────────────────────────────────────────────────
# Local Docker: use localhost:9092
KAFKA_SERVERS=localhost:9092
# Production (Upstash): copy from console.upstash.com → Kafka → Details
# KAFKA_BOOTSTRAP_SERVERS=xxx.upstash.io:9092
# KAFKA_KEY=your_upstash_kafka_key
# KAFKA_SECRET=your_upstash_kafka_secret

# ── Google Gemini AI ────────────────────────────────────────────────────────────
# Free tier: 15 req/min, 1M tokens/day — no billing required
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── IPQualityScore (optional) ───────────────────────────────────────────────────
# Free tier: 5,000 req/month
# Sign up at: https://www.ipqualityscore.com/create-account
# Leave blank to run without IP reputation scoring
IPQS_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your Vercel URL e.g. https://fraudguard.vercel.app
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080

# ── Email / 3D Secure OTP ───────────────────────────────────────────────────────
# Testing: use Mailtrap sandbox (free) — https://mailtrap.io
#   MAIL_HOST=sandbox.smtp.mailtrap.io
#   MAIL_PORT=2525
# Production: use Gmail App Password or SendGrid
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
OTP_ENABLED=true

# ── Spring Profile ─────────────────────────────────────────────────────────────
# dev  → local Docker (default)
# prod → managed cloud datastores (Neon, Upstash)
SPRING_PROFILES_ACTIVE=dev
