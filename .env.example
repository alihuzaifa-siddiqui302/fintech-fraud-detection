# FraudGuard Environment Configuration
# Copy to .env and fill in values

# PostgreSQL
DB_PASSWORD=your_secure_password_here

# JWT — minimum 32 characters, random string
JWT_SECRET=change-me-to-a-random-256-bit-secret

# IPQualityScore (free tier: 5000 req/month)
# Sign up at: https://www.ipqualityscore.com/create-account
# Leave blank to run without IPQS scoring
IPQS_API_KEY=

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173

# ── AI / LLM ──────────────────────────────────────
# Google Gemini 2.0 Flash (free tier)
# 15 requests/min, 1M tokens/day — no billing needed
GEMINI_API_KEY=

# ── Email / OTP ───────────────────────────────────
# For testing use Mailtrap: https://mailtrap.io
# (free, catches all emails in a sandbox inbox)
# For Gmail: enable "App Passwords" in Google Account
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# Set to true to enable 3DS OTP step-up on checkout
OTP_ENABLED=true


