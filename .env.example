# FraudGuard Environment Configuration
# Copy to .env and fill in values

# PostgreSQL
DB_PASSWORD=your_secure_password_here

# JWT — minimum 32 characters, random string
JWT_SECRET=change-me-to-a-random-256-bit-secret

# IPQualityScore (free tier: 5000 req/month)
# Sign up at: https://www.ipqualityscore.com/create-account
# Leave blank to run without IPQS scoring
IPQS_API_KEY=

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173

# ── AI / LLM ──────────────────────────────────────
# Google Gemini 2.0 Flash (free tier)
# 15 requests/min, 1M tokens/day — no billing needed
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

