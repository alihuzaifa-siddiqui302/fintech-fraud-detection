# FraudGuard Environment Configuration
# Copy to .env and fill in values

# PostgreSQL
DB_PASSWORD=your_secure_password_here

# JWT — minimum 32 characters, random string
JWT_SECRET=change-me-to-a-random-256-bit-secret

# IPQualityScore (free tier: 5000 req/month)
# Sign up at: https://www.ipqualityscore.com/create-account
# Leave blank to run without IPQS scoring
IPQS_API_KEY=

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173
